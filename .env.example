# Copy this file to `.env` and fill in the values.

# Supabase — https://supabase.com/dashboard → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# PostHog (US Cloud) — https://us.posthog.com → Settings → Project → Project API Key
# Leave VITE_POSTHOG_KEY blank to disable analytics; the app runs fine without it.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
